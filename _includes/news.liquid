<!-- DEBUGGING -->
<p>Current Year (from site.time): {{ site.time | date: '%Y' }}</p>
<hr>
<pre>{{ site.scholar | inspect }}</pre>
<hr>
<!-- END DEBUGGING -->

{% if site.news %}
  <div class="news">
    <h5>Announcements</h5>
    {% if include.limit and site.announcements.scrollable %}
      <div class="table-responsive" style="max-height: {{ site.announcements.limit | times: 3 | times: 1.2 }}rem; overflow-y: auto">
    {% else %}
      <div class="table-responsive">
    {% endif %}
    <table class="table table-sm table-borderless">
      {% assign news = site.news | reverse %}
      {% if include.limit %}
        {% assign news_limit = site.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% for item in news limit: news_limit %}
        <tr>
          <th scope="row">{{ item.date | date: '%b %-d, %Y' }}</th>
          <td>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
{% endif %}

<div class="news mt-4">
  <h5>Recent Publications</h5>
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% assign current_year = site.time | date: '%Y' %}
      {% assign found_publication = false %}
      {% for entry in site.scholar.entries %}
        {% assign publication_year = entry.year | string %}
        {% if publication_year == current_year %}
          <tr>
            {% assign month = entry.month | default: "1" %}
            {% assign date_str = entry.year | append: "-" | append: month | append: "-01" %}
            <th scope="row">{{ date_str | date: "%b, %Y" }}</th>
            <td>
              {{ entry.authors | join: ", " }}. &ldquo;<a href="{{ '/publications/' | relative_url }}#{{ entry.key }}">{{ entry.title }}</a>&rdquo; was accepted to <em>{{ entry.bib.booktitle | default: entry.bib.journal }}</em>.
            </td>
          </tr>
          {% assign found_publication = true %}
        {% endif %}
      {% endfor %}
      {% if found_publication == false %}
        <tr>
          <td colspan="2">No new publications this year.</td>
        </tr>
      {% endif %}
    </table>
  </div>
</div>